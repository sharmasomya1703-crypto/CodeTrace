# CodeTrace environment example — copy to .env and adjust.
# Never commit real secrets.

# Backend
CODETRACE_ENABLE_EVAL=true
CODETRACE_RUNNER=subprocess
CODETRACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CODETRACE_DEFAULT_TIMEOUT=2
CODETRACE_MAX_OUTPUT_BYTES=64000

# Frontend (Vite)
VITE_API_BASE=
